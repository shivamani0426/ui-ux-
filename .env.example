# DATABASE_URL is required for durable project memory in production.
DATABASE_URL=

# FRONTLINE AI: all credentials are server-only, stored in Render Environment.
# Preferred primary: OpenRouter free model router, subject to provider limits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_PRIMARY_PROVIDER=openrouter

# GroqCloud backup. Create at https://console.groq.com/keys
# Only active if GROQ_API_KEY exists and AI_FALLBACK_ENABLED=true.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_ENABLED=true

# Keep Gemini available but dormant; don't call it unless explicitly chosen.
# Gemini free-tier access can vary by region and project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional metadata for OpenRouter.
APP_PUBLIC_URL=https://ui-compass-studio.onrender.com

# Optional provider timeout (milliseconds, 3000-45000, default 28000).
AI_REQUEST_TIMEOUT_MS=28000


# Developer integrations: manual short-lived GitHub tokens still work.
# Optional GitHub App account connection needs ALL of the server-only values
# below, plus the private Supabase migration. Never use VITE_* for secrets.
# Figma importer remains a local offline development plugin (no OAuth token).
FRONTLINE_GITHUB_APP_CLIENT_ID=
FRONTLINE_GITHUB_APP_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FRONTLINE_GITHUB_ENCRYPTION_KEY=
# Also used for recent Google verification; use 48+ random characters.
FRONTLINE_ACTION_SIGNING_SECRET=
# Optional server-only admin key for fully verified account deletion.
FRONTLINE_SUPABASE_ADMIN_KEY=

# Optional, verified Supabase Google OAuth from Milestone 10 is required for
# authenticated GitHub publish and durable cross-device project sync.
FRONTLINE_SUPABASE_URL=
FRONTLINE_SUPABASE_PUBLISHABLE_KEY=
FRONTLINE_SITE_URL=https://ui-compass-studio.onrender.com
FRONTLINE_GOOGLE_LOGIN_ENABLED=false

# M08 original-publisher inspiration discovery: authorized Brave Search API key.
# Never send this to the browser or commit real keys.
# Without this, Select mode shows no fake results and links to original sources.
FRONTLINE_BRAVE_SEARCH_API_KEY=
