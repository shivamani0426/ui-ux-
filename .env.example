# DATABASE_URL is required for durable project memory in production.
DATABASE_URL=

# AI DESIGN ADVISOR — server-only. Never commit real API keys.
# Gemini is the primary provider. This model has an eligible free API tier;
# verify availability and usage limits in your Google AI Studio project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_PRIMARY_PROVIDER=gemini

# Optional backup provider. To send the same user prompt to OpenRouter
# after Gemini fails, explicitly set AI_FALLBACK_ENABLED=true.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_FALLBACK_ENABLED=false

# Optional metadata for OpenRouter (the live public site URL).
APP_PUBLIC_URL=https://ui-compass-studio.onrender.com
